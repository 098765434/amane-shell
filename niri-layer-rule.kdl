// GENERATED by `cargo run -q -- layer-rules > niri-layer-rule.kdl` from the
// design tokens (radii: sys.radius.popover, notification.card.radius,
// notification.center.radius) — do not edit by hand.
//
// The amane shell's niri layer-rules (compositor-side blur, rounding and
// shadow on its surfaces). Each rule matches an anchored regex on a
// layer-surface namespace that a component sets via LayerWindow::namespace(...).
//
// Don't hand-copy these into the niri config. gen-layer-rules.sh injects
// everything below the sentinel into the config between its
// `>>> amane layer-rules` / `<<<` markers (see docs/layer-rules.md); then:
//
//     niri validate -c ~/.config/niri/config.kdl
//     niri msg action load-config-file
//
// Verify the surfaces are up:  niri msg layers | grep amane

//<<<GENERATED-RULES-BELOW>>>  (gen-layer-rules.sh injects everything past this line)

// Status bar: one uniform frosted strip along the bottom, macOS 27's toolbar:
// frost, the standard material without a lens. It reserves its zone, so only
// the wallpaper is behind it and niri's xray blur is enough. Its xdg-popups
// (tooltips, Do Not Disturb's menu) are frosted cards.
layer-rule {
    match namespace="^amane\\.status-bar$"
    geometry-corner-radius 0
    background-effect {
        blur true
        material "frost"
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// Context menu. The anchor is an invisible 1×1 layer-surface; the visible
// cards (menu + nested submenus) are xdg-popups of it, so the `popups {}`
// block styles every level uniformly. Namespaces: the anchor is
// `amane.context-menu-anchor`; each depth level is `amane.context-menu.0`..`7`.
layer-rule {
    match namespace="^amane\\.context-menu-anchor$"

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// Quick Settings: a clear surface whose modules are frosted one by one, the
// surface saying where (ext-background-effect). Toggled by the status bar's
// Quick Settings button. A Bluetooth device's menu is an xdg-popup of it.
layer-rule {
    match namespace="^amane\\.quick-settings$"
    background-effect {
        xray false
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// Dock: a clear surface over the bar, one a monitor, whose card is frosted
// where the surface says (ext-background-effect). It comes up from the
// bottom edge; a window's menu is an xdg-popup of it.
layer-rule {
    match namespace="^amane\\.dock$"
    background-effect {
        xray false
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// Launcher: a clear surface over the output whose glass panel, in the middle,
// is frosted where the surface says (ext-background-effect). Toggled over IPC
// from a keybind. An app's menu is an xdg-popup of it.
layer-rule {
    match namespace="^amane\\.launcher$"
    background-effect {
        xray false
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// Notification toasts: one surface per banner, sized to its card, sliding in
// at the top-right. Each frosts its card itself (blur shapes, in the glass
// material); the rule rounds it and gives it niri's shadow.
layer-rule {
    match namespace="^amane\\.notifications\\.toast$"
    geometry-corner-radius 16
    shadow {
        on
        softness 16
        offset x=0 y=8
        color "#00000073"
    }
    background-effect {
        xray false
    }
}

// Notification center: a full-height glass sidebar at the right edge, opened
// from the clock, frosting itself (blur shapes, in the glass material); the
// rule rounds it and gives it niri's shadow. Its Do Not Disturb menu is an
// xdg-popup of it.
layer-rule {
    match namespace="^amane\\.notifications\\.center$"
    geometry-corner-radius 26
    shadow {
        on
        softness 16
        offset x=0 y=8
        color "#00000073"
    }
    background-effect {
        xray false
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// An amane app's windows: frosted behind, the window drawing its own tint
// over the frost (the window material), and its popups like the shell's.
window-rule {
    match app-id="^amane-settings$"
    background-effect {
        blur true
        material "frost"
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// The shell's materials (material.* tokens), by the names it asks for: liquid
// glass, its clear variant for media, and frost without a lens; each `-still`
// twin is for reduced motion. They replace a hand-written `materials {}` of
// the same names. See the niri fork's docs/wiki/Window-Effects.md.
materials {
    material "frost" {
        bevel 8
        blur-offset 2
        blur-passes 4
        dispersion 0
        far-rim 0
        glow 0
        light-angle 270
        refraction 0
        rim 0.12
        saturation 1.8
        specular 0
        tint 1
        tone 0.6
    }
    material "glass" {
        adaptive-tint 0.25
        bevel 12
        blur-offset 2
        blur-passes 3
        dispersion 0.3
        far-rim 0.5
        glow 0.05
        light-angle 270
        refraction 16
        report-backdrop true
        rim 0.35
        saturation 2
        specular 0.4
        tint 1
        tone 0.85
    }
    material "glass-clear" {
        bevel 16
        blur-offset 2
        blur-passes 3
        dispersion 0.4
        far-rim 0.5
        glow 0.08
        light-angle 270
        refraction 24
        report-backdrop true
        rim 0.3
        saturation 2
        specular 0.4
        tint 1
        tone 0.8
    }
    material "glass-large" {
        adaptive-tint 0.25
        bevel 12
        blur-offset 2
        blur-passes 4
        dispersion 0.3
        far-rim 0.5
        glow 0.05
        light-angle 270
        refraction 16
        report-backdrop true
        rim 0.35
        saturation 2
        specular 0.4
        tint 1
        tone 0.6
    }
    material "glass-small" {
        adaptive-tint 0.25
        bevel 8
        blur-offset 1.5
        blur-passes 2
        dispersion 0.3
        far-rim 0.5
        glow 0.05
        light-angle 270
        refraction 12
        report-backdrop true
        rim 0.35
        saturation 2
        specular 0.4
        tint 1
        tone 0.85
    }
    material "frost-still" {
        bevel 8
        blur-offset 2
        blur-passes 4
        dispersion 0
        far-rim 0
        glow 0
        light-angle 270
        refraction 0
        rim 0.12
        saturation 1.8
        specular 0
        tint 1
        tone 0.6
        materialize false
    }
    material "glass-still" {
        adaptive-tint 0.25
        bevel 12
        blur-offset 2
        blur-passes 3
        dispersion 0.3
        far-rim 0.5
        glow 0.05
        light-angle 270
        refraction 16
        report-backdrop true
        rim 0.35
        saturation 2
        specular 0.4
        tint 1
        tone 0.85
        materialize false
    }
    material "glass-clear-still" {
        bevel 16
        blur-offset 2
        blur-passes 3
        dispersion 0.4
        far-rim 0.5
        glow 0.08
        light-angle 270
        refraction 24
        report-backdrop true
        rim 0.3
        saturation 2
        specular 0.4
        tint 1
        tone 0.8
        materialize false
    }
    material "glass-large-still" {
        adaptive-tint 0.25
        bevel 12
        blur-offset 2
        blur-passes 4
        dispersion 0.3
        far-rim 0.5
        glow 0.05
        light-angle 270
        refraction 16
        report-backdrop true
        rim 0.35
        saturation 2
        specular 0.4
        tint 1
        tone 0.6
        materialize false
    }
    material "glass-small-still" {
        adaptive-tint 0.25
        bevel 8
        blur-offset 1.5
        blur-passes 2
        dispersion 0.3
        far-rim 0.5
        glow 0.05
        light-angle 270
        refraction 12
        report-backdrop true
