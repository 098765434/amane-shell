// GENERATED by `cargo run -q -- layer-rules > niri-layer-rule.kdl` from the
// design tokens (radii: sys.radius.popover, notification.card.radius,
// notification.center.radius) — do not edit by hand.
//
// The amane shell's niri layer-rules (compositor-side blur, rounding and
// shadow on its surfaces). Each rule matches an anchored regex on a
// layer-surface namespace that a component sets via LayerWindow::namespace(...).
//
// Don't hand-copy these into the niri config. gen-layer-rules.sh injects
// everything below the sentinel into the config between its
// `>>> amane layer-rules` / `<<<` markers (see docs/layer-rules.md); then:
//
//     niri validate -c ~/.config/niri/config.kdl
//     niri msg action load-config-file
//
// Verify the surfaces are up:  niri msg layers | grep amane

//<<<GENERATED-RULES-BELOW>>>  (gen-layer-rules.sh injects everything past this line)

// Status bar: one uniform frosted strip along the bottom, macOS 27's toolbar:
// plain frost, no glass material. It reserves its zone, so only the wallpaper
// is behind it and niri's xray blur is enough. Its xdg-popups (tooltips, Do
// Not Disturb's menu) are frosted cards.
layer-rule {
    match namespace="^amane\\.status-bar$"
    geometry-corner-radius 0
    background-effect {
        blur true
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// Context menu. The anchor is an invisible 1×1 layer-surface; the visible
// cards (menu + nested submenus) are xdg-popups of it, so the `popups {}`
// block styles every level uniformly. Namespaces: the anchor is
// `amane.context-menu-anchor`; each depth level is `amane.context-menu.0`..`7`.
layer-rule {
    match namespace="^amane\\.context-menu-anchor$"

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// Quick Settings: a clear surface whose modules are frosted one by one, the
// surface saying where (ext-background-effect). Toggled by the status bar's
// Quick Settings button. A Bluetooth device's menu is an xdg-popup of it.
layer-rule {
    match namespace="^amane\\.quick-settings$"
    background-effect {
        xray false
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// Dock: a clear surface over the bar, one a monitor, whose card is frosted
// where the surface says (ext-background-effect). It comes up from the
// bottom edge; a window's menu is an xdg-popup of it.
layer-rule {
    match namespace="^amane\\.dock$"
    background-effect {
        xray false
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// Launcher: a clear surface over the output whose glass panel, in the middle,
// is frosted where the surface says (ext-background-effect). Toggled over IPC
// from a keybind. An app's menu is an xdg-popup of it.
layer-rule {
    match namespace="^amane\\.launcher$"
    background-effect {
        xray false
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// Notification toasts: one surface per banner, sized to its card, sliding in
// at the top-right. Each frosts its card itself (blur shapes, in the glass
// material); the rule rounds it and gives it niri's shadow.
layer-rule {
    match namespace="^amane\\.notifications\\.toast$"
    geometry-corner-radius 16
    shadow {
        on
        softness 16
        offset x=0 y=8
        color "#00000073"
    }
    background-effect {
        xray false
    }
}

// Notification center: a full-height glass sidebar at the right edge, opened
// from the clock, frosting itself (blur shapes, in the glass material); the
// rule rounds it and gives it niri's shadow. Its Do Not Disturb menu is an
// xdg-popup of it.
layer-rule {
    match namespace="^amane\\.notifications\\.center$"
    geometry-corner-radius 26
    shadow {
        on
        softness 16
        offset x=0 y=8
        color "#00000073"
    }
    background-effect {
        xray false
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}
