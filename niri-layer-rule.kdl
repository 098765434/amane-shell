// Source of truth for the amane shell's niri layer-rules (compositor-side blur
// / rounding on its surfaces). Each rule matches an anchored regex on a
// layer-surface namespace that a component sets via LayerWindow::namespace(...).
//
// DO NOT hand-copy these into the niri config. Run the generator, which injects
// everything below the sentinel into ~/nixos-config/niri/config.kdl between its
// `>>> amane layer-rules` / `<<<` markers, then reload niri:
//
//     ./gen-layer-rules.sh
//     niri validate -c ~/nixos-config/niri/config.kdl
//     niri msg action reload-config
//
// Verify the surfaces are up:  niri msg layers | grep amane

//<<<GENERATED-RULES-BELOW>>>  (gen-layer-rules.sh injects everything past this line)

// Context menu. The anchor is an invisible 1×1 layer-surface; the visible
// cards (menu + nested submenus) are xdg-popups of it, so the `popups {}`
// block styles every level uniformly. Namespaces: the anchor is
// `amane.context-menu-anchor`; each depth level is `amane.context-menu.0`..`7`.
layer-rule {
    match namespace="^amane\\.context-menu-anchor$"

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
        }
    }
}

// Taskbar: a full-width bottom bar. It is deliberately NOT blurred — the bar
// is opaque; only the floating surfaces (popups + the Wi-Fi card) are frosted.
// (No layer-rule for `amane.taskbar` on purpose.)

// WiFi panel: a rounded frosted card anchored bottom-right, toggled by the
// taskbar's network indicator.
layer-rule {
    match namespace="^amane\\.taskbar\\.wifi$"
    geometry-corner-radius 14
    background-effect {
        blur true
    }
}
