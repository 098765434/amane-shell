{
  "$description": "amane context-menu design tokens (W3C Design Tokens Format 2025.10)",

  "color": {
    "$type": "color",
    "neutral": {
      "ink":   { "$value": { "colorSpace": "srgb", "components": [0.113, 0.113, 0.122] } },
      "chalk": { "$value": { "colorSpace": "srgb", "components": [0.961, 0.961, 0.969] } }
    },
    "accent": {
      "blue": { "$value": { "colorSpace": "srgb", "components": [0.039, 0.517, 1.000] } }
    },
    "destructive": {
      "red":      { "$value": { "colorSpace": "srgb", "components": [1.000, 0.270, 0.227] } },
      "red-tint": { "$value": { "colorSpace": "srgb", "components": [1.000, 0.270, 0.227], "alpha": 0.18 } }
    }
  },

  "radius": {
    "$type": "dimension",
    "card":    { "$value": { "value": 10, "unit": "px" } },
    "row":     { "$value": { "value": 5,  "unit": "px" } },
    "submenu": { "$value": { "value": 10, "unit": "px" } }
  },

  "space": {
    "$type": "dimension",
    "card-padding":     { "$value": { "value": 5,   "unit": "px" } },
    "row-h":            { "$value": { "value": 10,  "unit": "px" } },
    "gap":              { "$value": { "value": 8,   "unit": "px" } },
    "row-height":       { "$value": { "value": 24,  "unit": "px" } },
    "icon-slot":        { "$value": { "value": 16,  "unit": "px" } },
    "chevron-slot":     { "$value": { "value": 10,  "unit": "px" } },
    "separator":        { "$value": { "value": 1,   "unit": "px" } },
    "separator-margin": { "$value": { "value": 4,   "unit": "px" } },
    "min-width":        { "$value": { "value": 180, "unit": "px" } },
    "max-width":        { "$value": { "value": 420, "unit": "px" } },
    "submenu-offset":   { "$value": { "value": -4,  "unit": "px" } }
  },

  "font": {
    "ui": {
      "family": {
        "$type": "fontFamily",
        "$value": ["SF Pro Text", "Inter", "sans-serif"]
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "medium":  { "$value": 510 }
      }
    }
  },

  "type": {
    "label":    { "$type": "number", "size": { "$value": 13 } },
    "shortcut": {
      "$type": "number",
      "size":           { "$value": 13 },
      "hover-alpha":    { "$value": 0.72 }
    }
  },

  "animation": {
    "$type": "duration",
    "open-ms":  { "$value": { "value": 110, "unit": "ms" } },
    "close-ms": { "$value": { "value": 90,  "unit": "ms" } }
  },

  "theme": {
    "$type": "color",
    "light": {
      "surface":                { "$value": { "colorSpace": "srgb", "components": [0.965, 0.965, 0.965], "alpha": 0.55 } },
      "border":                 { "$value": { "colorSpace": "srgb", "components": [0, 0, 0],             "alpha": 0.08 } },
      "fg":                     { "$value": "{color.neutral.ink}" },
      "muted":                  { "$value": { "colorSpace": "srgb", "components": [0, 0, 0],             "alpha": 0.52 } },
      "hover-fill":             { "$value": { "colorSpace": "srgb", "components": [0, 0, 0],             "alpha": 0.08 } },
      "hover-destructive-fill": { "$value": "{color.destructive.red-tint}" },
      "selected-fill":          { "$value": "{color.accent.blue}" },
      "on-selected-fg":         { "$value": { "colorSpace": "srgb", "components": [1, 1, 1] } },
      "accent":                 { "$value": "{color.accent.blue}" },
      "separator":              { "$value": { "colorSpace": "srgb", "components": [0, 0, 0],             "alpha": 0.08 } },
      "destructive":            { "$value": "{color.destructive.red}" }
    },
    "dark": {
      "surface":                { "$value": { "colorSpace": "srgb", "components": [0.117, 0.117, 0.117], "alpha": 0.55 } },
      "border":                 { "$value": { "colorSpace": "srgb", "components": [1, 1, 1],             "alpha": 0.10 } },
      "fg":                     { "$value": "{color.neutral.chalk}" },
      "muted":                  { "$value": { "colorSpace": "srgb", "components": [1, 1, 1],             "alpha": 0.55 } },
      "hover-fill":             { "$value": { "colorSpace": "srgb", "components": [1, 1, 1],             "alpha": 0.10 } },
      "hover-destructive-fill": { "$value": "{color.destructive.red-tint}" },
      "selected-fill":          { "$value": "{color.accent.blue}" },
      "on-selected-fg":         { "$value": { "colorSpace": "srgb", "components": [1, 1, 1] } },
      "accent":                 { "$value": "{color.accent.blue}" },
      "separator":              { "$value": { "colorSpace": "srgb", "components": [1, 1, 1],             "alpha": 0.10 } },
      "destructive":            { "$value": "{color.destructive.red}" }
    }
  }
}
